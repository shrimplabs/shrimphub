;; The agent's own StateServer listener and any ephemeral local bind (pytest
;; fixtures, Godot's debug port) must be able to come up on loopback.
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))

;; LAN + tailnet hosts.
;;
;; IMPORTANT LIMITATION, measured rather than assumed: seatbelt's `remote ip`
;; accepts only "localhost:<port>" or "*:<port>".  It rejects both hostnames
;; and literal IPv4 addresses at profile-compile time, so there is no way to
;; say "this host, this port" here.  Pinning IPs is not an option and would be
;; fragile anyway -- the LAN hosts are DHCP leases.
;;
;; So these three rules are port-scoped, not host-scoped: any host answering on
;; 8083, 3000 or 8035 is reachable.  That is a real gap and is stated here so
;; nobody later mistakes this profile for a host allowlist.  What makes it an
;; acceptable one:
;;   - Ports 80 and 443 stay denied.  Verified: under a profile allowing *:80,
;;     curl to an arbitrary internet host on 80 returns 200, while 443 fails.
;;     Nearly every exfiltration destination and package index speaks 443, so
;;     denying it removes the broad path even though a narrow one remains.
;;   - 8083/3000/8035 are uncommon ports; a host reachable on them is far more
;;     likely to be on this LAN than to be an attacker-chosen endpoint.
;;   - The name-level check still exists in-process: fetch_url in
;;     swarm/tools/core.py enforces a host allowlist with per-hop redirect
;;     validation, and shell_guard blocks curl/wget with upload flags.
;; The kernel layer here is the backstop for those, not a replacement.
(allow network-outbound
  (remote ip "*:8083")   ;; LAN inference box
  (remote ip "*:3000")   ;; LAN Gitea, the git push target
  (remote ip "*:8035"))  ;; model-router on the tailnet
