{
  "workspace": "~/workspace",
  "max_active_agents": 3,
  "max_lines": 5000,
  "agent_timeout": 7200,
  "spawn_per_cycle": 1,

  "llm_provider": "minimax",
  "llm_providers": {
    "minimax": {
      "base_url": "https://api.minimax.io/anthropic/v1",
      "model": "MiniMax-M3"
    },
    "claude": {
      "model": "claude-sonnet-4-6"
    },
    "openrouter": {
      "model": "anthropic/claude-3.5-sonnet"
    }
  },
  "fallback_providers": [],
  "minimax_base_url": "",

  "adaptive_flat": true,
  "loop_model_routing": {
    "fast_provider": "",
    "strong_provider": ""
  },

  "event_bus_enabled": true,
  "compact_token_threshold": 120000,

  "quota_limit_percent": 90,
  "auto_scale": false,
  "auto_scale_floor": 1,

  "godot_path": "",
  "xogot_path": "",
  "xogot_projects": [],

  "language": "GDScript",
  "file_extensions": [".gd"],
  "ignore_dirs": [],
  "ignore_extensions": [],

  "managed_projects": [],
  "paused_projects": [],
  "lock_project": false,
  "task_selection_strategy": "least_recently_worked",

  "qa_max_cycles": 3,
  "thinking_task_types": [],
  "thinking_task_budget": 10000,

  "vision_provider": "minimax-mcp",
  "vision_provider_fast": "local",
  "vision_providers": {},

  "playthrough_auto_enabled": false,

  "disable_remote_repo": true,
  "login_required": false,

  "meta_investigation": true,
  "meta_investigation_provider": "",

  "auto_replan_projects": [],
  "project_pipelines": {},
  "phase_loop_limits_by_type": {},

  "use_worktrees": true,
  "allow_self_modification": false,
  "human_review_flag_enabled": false,
  "local_fallback_on_quota": false,

  "log_retention_days": 0,
  "log_rotation_action": "delete",
  "log_extract_signals": false,

  "escalation_policy": {
    "bug":         {"max_attempts": 3, "on_exhaust": "research", "research_max_attempts": 2},
    "feature":     {"max_attempts": 3, "on_exhaust": "research", "research_max_attempts": 2},
    "refactor":    {"max_attempts": 3, "on_exhaust": "research", "research_max_attempts": 2},
    "polish":      {"max_attempts": 3, "on_exhaust": "cancel"},
    "qa":          {"max_attempts": 2, "on_exhaust": "cancel"},
    "harness_qa":  {"max_attempts": 2, "on_exhaust": "cancel"},
    "hybrid_qa":   {"max_attempts": 2, "on_exhaust": "cancel"},
    "scenario_qa": {"max_attempts": 2, "on_exhaust": "cancel"},
    "art_pass":    {"max_attempts": 2, "on_exhaust": "cancel"},
    "audit":       {"max_attempts": 2, "on_exhaust": "cancel"},
    "research":    {"max_attempts": 2, "on_exhaust": "cancel"},
    "plan":        {"max_attempts": 2, "on_exhaust": "cancel"},
    "project_plan":{"max_attempts": 2, "on_exhaust": "cancel"}
  },

  "rag": {
    "enabled": false,
    "backend": "chromadb",
    "index_path": "~/godot-rag",
    "top_k": 5
  },

  "meta_mode_enabled": false,
  "meta_scheduler_enabled": false,
  "gardener_enabled": false,
  "gardener_max_tasks_per_run": 3,
  "gardener_skip_projects": [],
  "librarian_enabled": false,
  "librarian_trigger_interval": 50,
  "librarian_max_prompt_tasks": 3,
  "librarian_autonomous_edits": false,
  "cartographer_enabled": false,
  "cartographer_interval_hours": 2,
  "archaeologist_enabled": false,
  "archaeologist_stall_threshold_hours": 72,
  "archaeologist_max_concurrent": 2,
  "scheduler_enabled": false,
  "meta_auditor_enabled": false,
  "meta_auditor_interval_days": 7,

  "completion_webhook_url": "",
  "mcp_servers": {}
}
